<?xml version="1.0"?>
<!-- 腿：一根连杆 —— 大腿和小腿用的是同一根，尺寸/质量/惯量完全一样，只是装的方向相反
     （大腿往前下方长，小腿往后下方长）。

     约定：link 原点在**近端关节轴**上，也就是这条腿绕它转的那个轴；几何体从原点朝远端长出去。
     这样 body 里给的 xyz 就是"关节装在哪"，不用自己扣半个杆长：
     大腿的近端是胯轴，小腿的近端是膝轴。

     杆长和角度写在本文件顶上的 property 里（不是宏参数），因为整车摆位要用它们的投影：
       leg_length 0.056 m，leg_angle 40°（与水平面的夹角）
       → leg_span = L·cos40° = 42.9 mm（水平投影）
         leg_drop = L·sin40° = 36.0 mm（竖直投影）
     大、小腿对称张开成"∨"（膝盖在最低点），胯轴到轮轴 = 2·leg_drop = 72 mm。

     朝向用 direction 选，不用传角度：
       +1 → 远端在 ( +leg_span, 0, -leg_drop )，往前下方（大腿）
       -1 → 远端在 ( -leg_span, 0, -leg_drop )，往后下方（小腿）

     标准姿态就是这套默认值（α = 40°）。

     关节是 **revolute**（绕 y），q = 0 就是上面这个标准姿态（α=50°、β=80°、胯到轮轴 72mm）——
     关节原点不转、几何体按标准姿态画，所以零位天然对上。符号跟 lqr 那台的
     leg_wheel_robot.urdf.xacro 完全一致（那边的 q_urdf_hip 就是这里的 q_hip）：
       α = 50° - q_hip（α 从**竖直**量）、β = 80° - q_knee（膝内角，从伸直量），
       对称伸缩（e = 0，轮子还在胯轴正下方）时 q_knee = -2·q_hip；
       q_hip > 0 = 腿伸直、车身变高。
       限位不对称（胯 [-15°, 35°]、膝 [-65°, 25°]），按对称伸缩走实际只到
       q_hip ∈ [-12.5°, +32.5°]（先顶到膝的 -65°，不是胯自己的 [-15°, +35°]）；
       关节力矩 1.5 N·m（静态需求约 3 倍余量）、转速 6.0 rad/s、阻尼 0.05。
     力矩入口：每个腿关节挂一个 torque_motor，跟轮子同一个插件，话题
     /model/<模型名>/joint/<关节名>/cmd_force。现在没人往里发力矩（腿姿保持器见文档 §8 阶段 2），
     所以**光跑仿真腿会在自重下折下去**，不是模型改错了。

     用法（在 body 里，限位按关节传 leg.xacro 顶上那几个 property）：
       <xacro:leg name="left_thigh_link" joint_name="left_hip_joint"
                  parent="base_link" xyz="0 ${leg_y_offset} ${hip_height}"
                  lower="${hip_limit_lower}"  upper="${hip_limit_upper}"/>
       <xacro:leg name="left_calf_link"  joint_name="left_knee_joint"
                  parent="left_knee_link" direction="-1"
                  lower="${knee_limit_lower}" upper="${knee_limit_upper}"/> -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find gazebo)/models/basic/box.xacro"/>
  <xacro:include filename="$(find gazebo)/models/basic/joint.xacro"/>
  <xacro:include filename="$(find gazebo)/plugins/motor/torque_motor.xacro"/>

  <xacro:property name="leg_length"    value="0.056"/>
  <xacro:property name="leg_angle"     value="${40.0 * pi / 180.0}"/>
  <xacro:property name="leg_span"      value="${leg_length * cos(leg_angle)}"/>
  <xacro:property name="leg_drop"      value="${leg_length * sin(leg_angle)}"/>
  <xacro:property name="leg_half_span" value="${leg_span * 0.5}"/>
  <xacro:property name="leg_half_drop" value="${leg_drop * 0.5}"/>
  <xacro:property name="leg_pitch"     value="${pi / 2 - leg_angle}"/>

  <!-- 胯/膝的行程（详见文件头）。软限位是控制器里的事，这里写的是硬限位 -->
  <xacro:property name="hip_limit_lower"  value="${-15.0 * pi / 180.0}"/>
  <xacro:property name="hip_limit_upper"  value="${ 35.0 * pi / 180.0}"/>
  <xacro:property name="knee_limit_lower" value="${-65.0 * pi / 180.0}"/>
  <xacro:property name="knee_limit_upper" value="${ 25.0 * pi / 180.0}"/>
  <xacro:property name="leg_effort"       value="1.5"/>
  <xacro:property name="leg_velocity"     value="6.0"/>
  <xacro:property name="leg_damping"      value="0.05"/>

  <xacro:macro name="leg" params="
    name
    joint_name
    parent
    lower
    upper
    xyz:='0 0 0'
    direction:=1
    motor:='true'
    section:='0.016 0.018'
    mass:=0.03
    ixx:=0.0000087
    iyy:=0.0000085
    izz:=0.0000015
    color_name:=leg_black
    color_rgba:='0.2 0.2 0.2 1.0'">

    <!-- box_link 的 xyz/rpy 是"几何体+质心相对 link 原点的位姿"：
         先把杆竖直摆好、再绕 y 转 leg_pitch（让它与水平面成 40°），最后平移到杆的中点
         （中点 = 远端的一半）。direction 同时翻这两处，杆就朝另一边张开。
         size 是 '长 宽 高'，竖着放的杆高度就是杆长 -->
    <xacro:box_link
      name="${name}"
      size="${section} ${leg_length}"
      xyz="${direction * leg_half_span} 0 ${-leg_half_drop}"
      rpy="0 ${-direction * leg_pitch} 0"
      mass="${mass}"
      ixx="${ixx}"
      iyy="${iyy}"
      izz="${izz}"
      color_name="${color_name}"
      color_rgba="${color_rgba}"/>

    <!-- 绕 y：整台车的关节都躺在 y 轴上，轴向量传错不报错，只是模型静默地转错方向 -->
    <xacro:revolute_joint name="${joint_name}" parent="${parent}" child="${name}" xyz="${xyz}"
                          lower="${lower}" upper="${upper}"
                          effort="${leg_effort}" velocity="${leg_velocity}" damping="${leg_damping}"/>

    <xacro:if value="${motor}">
      <xacro:torque_motor joint_name="${joint_name}"/>
    </xacro:if>
  </xacro:macro>
</robot>
