<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="sphere_link" params="
    name
    radius:=0.05
    xyz:='0 0 0'
    rpy:='0 0 0'
    mass:=1.0
    ixx:=0.001
    ixy:=0.0
    ixz:=0.0
    iyy:=0.001
    iyz:=0.0
    izz:=0.001
    color_name:=dust_material
    color_rgba:='0.7 0.7 0.7 1.0'">
    <link name="${name}">
      <inertial>
        <origin xyz="${xyz}" rpy="${rpy}"/>
        <mass value="${mass}"/>
        <inertia
          ixx="${ixx}"
          ixy="${ixy}"
          ixz="${ixz}"
          iyy="${iyy}"
          iyz="${iyz}"
          izz="${izz}"/>
      </inertial>
      <visual>
        <origin xyz="${xyz}" rpy="${rpy}"/>
        <geometry>
          <sphere radius="${radius}"/>
        </geometry>
        <material name="${color_name}">
          <color rgba="${color_rgba}"/>
        </material>
      </visual>
      <collision>
        <origin xyz="${xyz}" rpy="${rpy}"/>
        <geometry>
          <sphere radius="${radius}"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>
</robot>
